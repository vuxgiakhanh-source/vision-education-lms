# ==========================================
# DATABASE MYSQL CONFIGURATION
# ==========================================
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=vision_education_lms
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
# Mặc định 127.0.0.1:3306 (không dùng localhost vì trên Windows mỗi kết nối chậm thêm ~2 giây). Chỉ cần đặt khi MySQL chạy ở máy khác hoặc cổng khác.
# MYSQL_HOST=localhost
# MYSQL_PORT=3306

# Pool kết nối của MỖI tiến trình API. Tổng kết nối tối đa = (DB_POOL_SIZE + DB_MAX_OVERFLOW) x số tiến trình,
# và phải nhỏ hơn MYSQL_MAX_CONNECTIONS. Yêu cầu chờ quá DB_POOL_TIMEOUT giây thì báo lỗi thay vì treo.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=1800

# ==========================================
# JWT SECURITY & AUTHENTICATION
# ==========================================
# Sinh chuỗi ngẫu nhiên bằng lệnh: openssl rand -hex 32
# Tối thiểu 32 ký tự, ứng dụng không khởi động nếu ngắn hơn.
SECRET_KEY=your_secret_key_here
# 180 = 3 giờ: phủ một ca thi 90 phút nếu em đăng nhập trong vòng khoảng 1,5 giờ trước hạn nộp.
# Mỗi request vẫn kiểm tra is_active và vai trò trong DB nên khóa tài khoản có hiệu lực ngay.
# Phần thi dùng token theo lượt (hạn = deadline_at + ân hạn), không phụ thuộc giờ đăng nhập.
ACCESS_TOKEN_EXPIRE_MINUTES=180

# ==========================================
# CORS CONFIGURATION (Danh sách Origin phân tách bằng dấu phẩy)
# ==========================================
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# MÔI TRƯỜNG
# ==========================================
# production: tắt /docs, /redoc, /openapi.json. Mặc định là development.
# ENVIRONMENT=development
# Thư mục ghi log. Mặc định backend/logs.
# LOG_DIR=
