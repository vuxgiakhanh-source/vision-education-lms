FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt ./requirements.txt
COPY deploy/requirements.txt ./deploy/requirements.txt
RUN pip install --no-cache-dir -r deploy/requirements.txt && useradd --uid 10001 --create-home learner
COPY lms_lab ./lms_lab
COPY deploy ./deploy
USER learner
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "lms_lab.server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--no-access-log"]
