@@ -0,0 +1,18 @@
+from pydantic import BaseModel, ConfigDict, Field, field_validator
+
+
+class ClassInput(BaseModel):
+    model_config = ConfigDict(extra='forbid')
+    title: str = Field(min_length=1, max_length=200)
+
+    @field_validator('title', mode='before')
+    @classmethod
+    def normalize_title(cls, value):
+        return value.strip() if isinstance(value, str) else value
+
+
+class ClassOutput(BaseModel):
+    model_config = ConfigDict(from_attributes=True)
+    id: int
+    title: str
+    teacher_id: int
diff --git a/lms_lab/classes/repository.py b/lms_lab/classes/repository.py
new file mode 100644
--- /dev/null
+++ b/lms_lab/classes/repository.py
@@ -0,0 +1,27 @@
+from sqlalchemy import select
+from ..models import Classroom, Membership
+
+
+class ClassRepository:
+    def __init__(self, db):
+        self.db = db
+
+    def list_visible(self, actor, offset: int, limit: int):
+        query = select(Classroom)
+        if actor.role == 'teacher':
+            query = query.where(Classroom.teacher_id == actor.id)
+        else:
+            query = query.join(Membership).where(Membership.student_id == actor.id)
+        return list(self.db.scalars(query.order_by(Classroom.id).offset(offset).limit(limit)))
+
+    def find(self, class_id: int):
+        return self.db.get(Classroom, class_id)
+
+    def is_member(self, class_id: int, actor_id: int) -> bool:
+        query = select(Membership.id).where(
+            Membership.class_id == class_id, Membership.student_id == actor_id)
+        return self.db.scalar(query) is not None
+
+    def add(self, classroom):
+        self.db.add(classroom)
+        self.db.flush()
diff --git a/lms_lab/classes/service.py b/lms_lab/classes/service.py
new file mode 100644
--- /dev/null
+++ b/lms_lab/classes/service.py
@@ -0,0 +1,59 @@
+from ..models import Classroom
+from ..unit_of_work import Transaction
+
+
+class Forbidden(Exception):
+    pass
+
+
+class NotFound(Exception):
+    pass
+
+
+class ClassService:
+    def __init__(self, repository, transaction: Transaction):
+        self.repository = repository
+        self.transaction = transaction
+
+    def list_visible(self, actor, page: int, page_size: int):
+        return self.repository.list_visible(actor, (page - 1) * page_size, page_size)
+
+    def read(self, actor, class_id: int):
+        classroom = self.repository.find(class_id)
+        if classroom is None:
+            raise NotFound()
+        visible = classroom.teacher_id == actor.id if actor.role == 'teacher' else (
+            self.repository.is_member(class_id, actor.id))
+        if not visible:
+            raise NotFound()
+        return classroom
+
+    def create(self, actor, title: str):
+        if actor.role != 'teacher':
+            raise Forbidden()
+        title = title.strip()
+        if not 1 <= len(title) <= 200:
+            raise ValueError('Tên lớp không hợp lệ')
+        classroom = Classroom(title=title, teacher_id=actor.id)
+        try:
+            self.repository.add(classroom)
+            self.transaction.commit()
+        except Exception:
+            self.transaction.rollback()
+            raise
+        return classroom
+
+    def rename(self, actor, class_id: int, title: str):
+        classroom = self.read(actor, class_id)
+        if actor.role != 'teacher' or classroom.teacher_id != actor.id:
+            raise Forbidden()
+        title = title.strip()
+        if not 1 <= len(title) <= 200:
+            raise ValueError('Tên lớp không hợp lệ')
+        try:
+            classroom.title = title
+            self.transaction.commit()
+        except Exception:
+            self.transaction.rollback()
+            raise
+        return classroom
