+"""Add state without deleting existing classrooms or their history."""
+from alembic import op
+import sqlalchemy as sa
+
+revision = '0002_archive'
+down_revision = '0001'
+branch_labels = None
+depends_on = None
+
+
+def upgrade():
+    op.add_column('classes', sa.Column('archived', sa.Boolean(), nullable=False, server_default=sa.false()))
+
+
+def downgrade():
+    # Removing this state can reopen archived classes. Review before any rollback.
+    op.drop_column('classes', 'archived')
